<?xml version="1.0" encoding="UTF-8"?>
<robot name="tiago_dual">
  <group name="arm_left">
    <joint name="torso_lift_joint"/>
    <joint name="arm_left_1_joint"/>
    <joint name="arm_left_2_joint"/>
    <joint name="arm_left_3_joint"/>
    <joint name="arm_left_4_joint"/>
    <joint name="arm_left_5_joint"/>
    <joint name="arm_left_6_joint"/>
    <joint name="arm_left_7_joint"/>
    <joint name="arm_left_tool_joint"/>
  </group>

  <group name="arm_right">
    <joint name="torso_lift_joint"/>
    <joint name="arm_right_1_joint"/>
    <joint name="arm_right_2_joint"/>
    <joint name="arm_right_3_joint"/>
    <joint name="arm_right_4_joint"/>
    <joint name="arm_right_5_joint"/>
    <joint name="arm_right_6_joint"/>
    <joint name="arm_right_7_joint"/>
    <joint name="arm_right_tool_joint"/>
  </group>

  <group name="gripper_left">
    <joint name="gripper_left_left_finger_joint"/>
    <joint name="gripper_left_right_finger_joint"/>
  </group>

  <group name="gripper_right">
    <joint name="gripper_right_left_finger_joint"/>
    <joint name="gripper_right_right_finger_joint"/>
  </group>

  <group_state name="home" group="arm_left">
    <joint name="torso_lift_joint" value="0.1"/>
    <joint name="arm_left_1_joint" value="0.2"/>
    <joint name="arm_left_2_joint" value="-0.3"/>
    <joint name="arm_left_3_joint" value="1.2"/>
    <joint name="arm_left_4_joint" value="1.4"/>
    <joint name="arm_left_5_joint" value="0.0"/>
    <joint name="arm_left_6_joint" value="0.2"/>
    <joint name="arm_left_7_joint" value="0.0"/>
  </group_state>

  <group_state name="open" group="gripper_left">
    <joint name="gripper_left_left_finger_joint" value="0.03"/>
    <joint name="gripper_left_right_finger_joint" value="0.03"/>
  </group_state>

  <group_state name="closed" group="gripper_left">
    <joint name="gripper_left_left_finger_joint" value="0.005"/>
    <joint name="gripper_left_right_finger_joint" value="0.005"/>
  </group_state>

  <group_state name="home_right" group="arm_right">
    <joint name="torso_lift_joint" value="0.1"/>
    <joint name="arm_right_1_joint" value="-0.2"/>
    <joint name="arm_right_2_joint" value="-0.3"/>
    <joint name="arm_right_3_joint" value="1.2"/>
    <joint name="arm_right_4_joint" value="1.4"/>
    <joint name="arm_right_5_joint" value="0.0"/>
    <joint name="arm_right_6_joint" value="0.2"/>
    <joint name="arm_right_7_joint" value="0.0"/>
  </group_state>

  <group_state name="open_right" group="gripper_right">
    <joint name="gripper_right_left_finger_joint" value="0.03"/>
    <joint name="gripper_right_right_finger_joint" value="0.03"/>
  </group_state>

  <group_state name="closed_right" group="gripper_right">
    <joint name="gripper_right_left_finger_joint" value="0.005"/>
    <joint name="gripper_right_right_finger_joint" value="0.005"/>
  </group_state>

  <end_effector
    name="left_gripper"
    parent_link="arm_left_tool_link"
    group="gripper_left"/>

  <end_effector
    name="right_gripper"
    parent_link="arm_right_tool_link"
    group="gripper_right"/>

  <virtual_joint
    name="world_joint"
    type="fixed"
    parent_frame="odom"
    child_link="base_footprint"/>

  <disable_collisions link1="arm_left_6_link" link2="arm_left_7_link" reason="Adjacent"/>
  <disable_collisions link1="arm_left_5_link" link2="arm_left_6_link" reason="Adjacent"/>
  <disable_collisions link1="arm_left_4_link" link2="arm_left_5_link" reason="Adjacent"/>
  <disable_collisions link1="arm_left_3_link" link2="arm_left_4_link" reason="Adjacent"/>
  <disable_collisions link1="arm_left_2_link" link2="arm_left_3_link" reason="Adjacent"/>
  <disable_collisions link1="arm_left_1_link" link2="arm_left_2_link" reason="Adjacent"/>
  <disable_collisions link1="torso_lift_link" link2="arm_left_1_link" reason="Adjacent"/>
  <disable_collisions link1="arm_left_tool_link" link2="wrist_left_ft_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_left_ft_link" link2="wrist_left_ft_tool_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_left_ft_link" link2="gripper_left_link" reason="Default"/>
  <disable_collisions link1="wrist_left_ft_tool_link" link2="gripper_left_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_left_left_finger_link" link2="gripper_left_right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="arm_right_6_link" link2="arm_right_7_link" reason="Adjacent"/>
  <disable_collisions link1="arm_right_5_link" link2="arm_right_6_link" reason="Adjacent"/>
  <disable_collisions link1="arm_right_4_link" link2="arm_right_5_link" reason="Adjacent"/>
  <disable_collisions link1="arm_right_3_link" link2="arm_right_4_link" reason="Adjacent"/>
  <disable_collisions link1="arm_right_2_link" link2="arm_right_3_link" reason="Adjacent"/>
  <disable_collisions link1="arm_right_1_link" link2="arm_right_2_link" reason="Adjacent"/>
  <disable_collisions link1="head_1_link" link2="head_2_link" reason="Adjacent"/>
  <disable_collisions link1="torso_fixed_column_link" link2="torso_lift_link" reason="Adjacent"/>
  <disable_collisions link1="torso_lift_link" link2="arm_right_1_link" reason="Adjacent"/>
  <disable_collisions link1="arm_right_tool_link" link2="wrist_right_ft_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_right_ft_link" link2="wrist_right_ft_tool_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_right_ft_tool_link" link2="gripper_right_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_right_ft_link" link2="gripper_right_link" reason="Default"/>
  <disable_collisions link1="gripper_right_left_finger_link" link2="gripper_right_right_finger_link" reason="Adjacent"/>
  <!-- base_link collision primitives overlap arm / opposite gripper in some sim poses; OMPL then fails path validation at waypoints 0–1. -->
  <disable_collisions link1="base_link" link2="arm_left_1_link" reason="Default"/>
  <disable_collisions link1="base_link" link2="arm_left_2_link" reason="Default"/>
  <disable_collisions link1="base_link" link2="arm_left_3_link" reason="Default"/>
  <disable_collisions link1="base_link" link2="arm_left_4_link" reason="Default"/>
  <disable_collisions link1="base_link" link2="arm_right_1_link" reason="Default"/>
  <disable_collisions link1="base_link" link2="arm_right_2_link" reason="Default"/>
  <disable_collisions link1="base_link" link2="arm_right_3_link" reason="Default"/>
  <disable_collisions link1="base_link" link2="arm_right_4_link" reason="Default"/>
  <disable_collisions link1="base_link" link2="gripper_left_link" reason="Default"/>
  <disable_collisions link1="base_link" link2="gripper_right_link" reason="Default"/>
</robot>
